// std/time.gdrs
use std::fmt::Display
use std::libc::{malloc, free}
use std::core::{Option}

extern "C":
	fn clock_gettime(clk_id: i32, tp: *void) -> i32

obj Instant:
	sec: i64
	nsec: i64

impl Instant:
	fn now() -> Instant:
		unsafe:
			let p = malloc(16)
			if (p as i64) == 0:
				return Instant{sec: 0, nsec: 0}
			let ts = p as *i64
			clock_gettime(0, ts as *void)
			let sec = *ts
			let nsec = *(ts + 1)
			free(ts as *void)
			return Instant{sec: sec, nsec: nsec}

	fn ms(self) -> i64:
		let end = Instant::now()
		let sec_diff = end.sec - self.sec
		let nsec_diff = end.nsec - self.nsec
		return (sec_diff * 1000) + (nsec_diff / 1000000)

	fn us(self) -> i64:
		let end = Instant::now()
		let sec_diff = end.sec - self.sec
		let nsec_diff = end.nsec - self.nsec
		return (sec_diff * 1000000) + (nsec_diff / 1000)
