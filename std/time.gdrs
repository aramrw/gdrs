// std/time.gdrs
use std::fmt::Display
use std::libc::{malloc, free}
use std::core::{Option}

extern "C":
	fn clock_gettime(clk_id: i32, tp: *void) -> i32

pub obj Instant:
	pub sec: i64
	pub nsec: i64

impl Instant:
	pub fn now() -> Instant:
		unsafe:
			let mut ts = Instant{sec: 0, nsec: 0}
			clock_gettime(8, (&mut ts) as *void)
			return ts

	pub fn ms(self) -> i64:
		let end = Instant::now()
		let sec_diff = end.sec - self.sec
		let nsec_diff = end.nsec - self.nsec
		return (sec_diff * 1_000_000_000 + nsec_diff) / 1_000_000

	pub fn us(self) -> i64:
		let end = Instant::now()
		let sec_diff = end.sec - self.sec
		let nsec_diff = end.nsec - self.nsec
		return (sec_diff * 1000000) + (nsec_diff / 1000)
