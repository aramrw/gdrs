// std/fs.gdrs
use std::core::{Result, Option}
use std::error::Error
use std::fmt::Display

fn buffer_to_string(ptr: i64, size: i64) -> str:
	return ptr

#[derive(Error)]
enum IoError:
	#[err("Failed to open file at path: '{0}'")]
	OpenFailed(String)
	#[err("Failed to allocate memory for file read")]
	AllocationFailed
	#[err("Failed to read file contents")]
	ReadFailed

extern "C":
	fn fopen(filename: str, mode: str) -> i64
	fn fseek(stream: i64, offset: i64, whence: i32) -> i32
	fn ftell(stream: i64) -> i64
	fn fread(ptr: i64, size: i64, nmemb: i64, stream: i64) -> i64
	fn fclose(stream: i64) -> i32
	fn malloc(size: i64) -> i64
	fn free(ptr: i64)
	fn memset(ptr: i64, val: i32, size: i64) -> i64

obj File:
	handle: i64

impl File:
	fn open(path: str) -> Result<File, IoError>:
		unsafe:
			let ptr = fopen(path, "r")
			if ptr == 0:
				return Err(IoError::OpenFailed(path))
			
			return Ok(File{handle: ptr})

	fn read_to_string(self) -> Result<String, IoError>:
		unsafe:
			let stream = self.handle
			if stream == 0:
				return Err(IoError::ReadFailed)

			// 1. Seek to end of file to find size
			fseek(stream, 0, 2)
			let size = ftell(stream)

			// 2. Seek back to the beginning to read
			fseek(stream, 0, 0)

			// 3. Allocate buffer (+1 for null terminator safety)
			let buffer = malloc(size + 1)
			if buffer == 0:
				fclose(stream)
				return Err(IoError::AllocationFailed)

			// 4. Read data into the buffer pointer
			fread(buffer, 1, size, stream)
			memset(buffer + size, 0, 1)

			// Clean up file handle
			fclose(stream)

			return Ok(buffer_to_string(buffer, size))

	fn close(self) -> i32:
		unsafe:
			return fclose(self.handle)
