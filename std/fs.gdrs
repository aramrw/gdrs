// std/fs.gdrs
use std::core::{Result, Option, Drop}
use std::error::Error
use std::fmt::Display
use std::libc::{malloc, free, memset, strlen}
use std::vec::Vec

use std::string::String

fn buffer_to_string(ptr: *void, size: i64) -> String:
	return String::from_raw_parts(ptr as *i64, size, size + 1)

#[derive(Error, Debug)]
pub enum IoError:
	#[err("Failed to open file or directory at path: '{0}'")]
	OpenFailed(String)
	#[err("Failed to allocate memory for file read")]
	AllocationFailed
	#[err("Failed to read file contents")]
	ReadFailed
	#[err("Failed to write file contents")]
	WriteFailed

extern "C":
	fn fopen(filename: str, mode: str) -> i64
	fn fseek(stream: i64, offset: i64, whence: i32) -> i32
	fn ftell(stream: i64) -> i64
	fn fread(ptr: *void, size: i64, nmemb: i64, stream: i64) -> i64
	fn fwrite(ptr: *void, size: i64, nmemb: i64, stream: i64) -> i64
	fn fflush(stream: i64) -> i32
	fn fclose(stream: i64) -> i32
	fn gdrs_fs_read_dir(path: str, out_vec: *void) -> i64

pub obj DirEntry:
	path_str: String
	name_str: String
	is_directory: bool
	is_regular_file: bool

impl DirEntry:
	pub fn path(&self) -> String:
		return String::from(self.path_str.as_str())

	pub fn file_name(&self) -> String:
		return String::from(self.name_str.as_str())

	pub fn is_dir(&self) -> bool:
		return self.is_directory

	pub fn is_file(&self) -> bool:
		return self.is_regular_file

pub fn read_dir(path: str) -> Result<Vec<DirEntry>, IoError>:
	unsafe:
		let mut vec_val: Vec<DirEntry> = Vec::new()
		if gdrs_fs_read_dir(path, (&mut vec_val) as *void) != 0:
			return Err(IoError::OpenFailed(String::from(path)))
		return Ok(vec_val)

pub fn read_to_string(path: str) -> Result<String, IoError>:
	let file_res = File::open(path)
	match file_res:
		Result::Ok(f) => f.read_to_string()
		Result::Err(e) => Err(e)

pub fn write(path: str, content: str) -> Result<(), IoError>:
	let mut f = File::create(path)?
	f.write_str(content)?
	return Ok(())

pub fn write_bytes(path: str, data: &[u8]) -> Result<(), IoError>:
	let mut f = File::create(path)?
	f.write_bytes(data)?
	return Ok(())

pub fn append(path: str, content: str) -> Result<(), IoError>:
	let mut f = File::open_append(path)?
	f.write_str(content)?
	return Ok(())

pub obj File:
	handle: i64

impl Drop for File:
	fn drop(mut self):
		unsafe:
			if self.handle != 0:
				fclose(self.handle)
				self.handle = 0

impl File:
	fn open_with_mode(path: str, mode: str) -> Result<File, IoError>:
		unsafe:
			let ptr = fopen(path, mode)
			if ptr == 0:
				return Err(IoError::OpenFailed(String::from(path)))
			return Ok(File{handle: ptr})

	pub fn open(path: str) -> Result<File, IoError>:
		return File::open_with_mode(path, "r")

	pub fn create(path: str) -> Result<File, IoError>:
		return File::open_with_mode(path, "wb")

	pub fn open_append(path: str) -> Result<File, IoError>:
		return File::open_with_mode(path, "ab")

	pub fn write_str(&mut self, content: str) -> Result<(), IoError>:
		unsafe:
			if self.handle == 0:
				return Err(IoError::WriteFailed)
			let n = strlen(content)
			if n == 0:
				return Ok(())
			let written = fwrite(content as *void, 1, n, self.handle)
			if written < n:
				return Err(IoError::WriteFailed)
			return Ok(())

	pub fn write_bytes(&mut self, data: &[u8]) -> Result<(), IoError>:
		unsafe:
			if self.handle == 0:
				return Err(IoError::WriteFailed)
			let n = data.len()
			if n == 0:
				return Ok(())
			let written = fwrite((&data[0]) as *void, 1, n, self.handle)
			if written < n:
				return Err(IoError::WriteFailed)
			return Ok(())

	pub fn flush(&mut self) -> Result<(), IoError>:
		unsafe:
			if self.handle == 0:
				return Err(IoError::WriteFailed)
			if fflush(self.handle) != 0:
				return Err(IoError::WriteFailed)
			return Ok(())

	pub fn read_to_string(mut self) -> Result<String, IoError>:
		unsafe:
			let stream = self.handle
			if stream == 0:
				return Err(IoError::ReadFailed)

			// 1. Seek to end of file to find size
			fseek(stream, 0, 2)
			let size = ftell(stream)
			if size < 0:
				fclose(stream)
				self.handle = 0
				return Err(IoError::ReadFailed)

			// 2. Seek back to the beginning to read
			fseek(stream, 0, 0)

			// 3. Allocate buffer (+1 for null terminator safety)
			let mut buffer = malloc(size + 1)
			if (buffer as i64) == 0:
				fclose(stream)
				self.handle = 0
				return Err(IoError::AllocationFailed)

			// 4. Read data into the buffer pointer
			let read_bytes = fread(buffer, 1, size, stream)
			let mut actual_size = 0
			if read_bytes > 0:
				actual_size = read_bytes
			let end_ptr = (buffer as i64) + actual_size
			memset(end_ptr as *void, 0, 1)

			// Clean up file handle
			fclose(stream)
			self.handle = 0

			return Ok(buffer_to_string(buffer, actual_size))

	pub fn close(mut self) -> i32:
		unsafe:
			if self.handle == 0:
				return 0
			let res = fclose(self.handle)
			self.handle = 0
			return res
