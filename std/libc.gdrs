// std/libc.gdrs - Standard C library declarations for heap allocation and memory
use std::core::{Option}

extern "C":
	pub fn malloc(size: i64) -> *void
	pub fn realloc(ptr: *void, size: i64) -> *void
	pub fn free(ptr: *void)
	pub fn memcpy(dest: *void, src: *void, count: i64) -> *void
	pub fn memset(ptr: *void, val: i32, size: i64) -> *void
	pub fn strlen(s: str) -> i64
	pub fn strdup(s: str) -> *void
	pub fn strcmp(s1: str, s2: str) -> i32
	pub fn strncmp(s1: str, s2: str, n: i64) -> i32
	pub fn strcpy(dest: *void, src: str) -> *void
	pub fn getenv(name: str) -> *void
	pub fn setenv(name: str, value: str, overwrite: i32) -> i32
	pub fn unsetenv(name: str) -> i32
