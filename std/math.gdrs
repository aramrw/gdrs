// Module: math.gdrs
use ops::Add
use ops::Sub

obj Vec2 where $T: Add:
	x: $T
	y: $T

impl Vec2:
	fn new(x: $T, y: $T) -> Vec2:
		Vec2{x: x, y: y}

impl Add for Vec2 where $T: Add: 
	fn add(self, other: Vec2) -> Vec2:
		let x = self.x + other.x
		let y = self.y + other.y
		return self.new(x, y)

impl Sub for Vec2 where $T: Sub: 
	fn sub(self, other: Vec2) -> Vec2:
		let x = self.x - other.x
		let y = self.y - other.y
		return self.new(x, y)

obj Vec3 where $T: Add:
	x: $T
	y: $T
	z: $T

impl Vec3:
	fn new(x: $T, y: $T, z: $T) -> Vec3:
		Vec3{x: x, y: y, z: z}

impl Add for Vec3: 
	fn add(self, other: Vec3) -> Vec3:
		let x = self.x + other.x
		let y = self.y + other.y
		let z = self.z + other.z
		return self.new(x, y, z)

impl Sub for Vec3: 
	fn sub(self, other: Vec3) -> Vec3:
		let x = self.x - other.x
		let y = self.y - other.y
		let z = self.z - other.z
		return self.new(x, y, z)

extern "C":
	fn c_exp(x: f64) -> f64
	fn c_sqrt(x: f64) -> f64
	fn c_sin(x: f64) -> f64
	fn c_cos(x: f64) -> f64
	fn c_tan(x: f64) -> f64
	fn c_pow(base: f64, exp: f64) -> f64
	fn c_fabs(x: f64) -> f64

fn exp(x: f64) -> f64:
	unsafe:
		return c_exp(x)

fn sqrt(x: f64) -> f64:
	unsafe:
		return c_sqrt(x)

fn sin(x: f64) -> f64:
	unsafe:
		return c_sin(x)

fn cos(x: f64) -> f64:
	unsafe:
		return c_cos(x)

fn tan(x: f64) -> f64:
	unsafe:
		return c_tan(x)

fn pow(base: f64, exponent: f64) -> f64:
	unsafe:
		return c_pow(base, exponent)

fn abs(x: f64) -> f64:
	unsafe:
		return c_fabs(x)

fn fabs(x: f64) -> f64:
	unsafe:
		return c_fabs(x)


