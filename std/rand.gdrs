// std/rand.gdrs
use std::time::Instant

obj Rng:
	state: u64

impl Rng:
	fn from_seed(seed: u64) -> Rng:
		return Rng{state: seed}

	fn new() -> Rng {
		let t = Instant::now()
		let mut dummy: u64 = 0
		let ptr_bits = (&mut dummy) as *void as u64
		let time_bits = ((t.sec as u64) * 1000000000) ^ (t.nsec as u64)
		return Rng{state: time_bits ^ (ptr_bits << 17)}
	}

	fn next_u64(&mut self) -> u64 {
		self.state = self.state + 0x9e3779b97f4a7c15
		let mut z = self.state
		z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
		z = (z ^ (z >> 27)) * 0x94d049bb133111eb
		return z ^ (z >> 31)
	}

	fn next_f64(&mut self) -> f64:
		// 2^-53 = 1.1102230246251565e-16
		return ((self.next_u64() >> 11) as f64) * 1.1102230246251565e-16

	fn range_f64(&mut self, min: f64, max: f64) -> f64:
		return min + self.next_f64() * (max - min)

	fn range_i64(&mut self, min: i64, max: i64) -> i64:
		let span = (max - min + 1) as u64
		return min + ((self.next_u64() % span) as i64)
