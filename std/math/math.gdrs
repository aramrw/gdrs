// Module: math.gdrs
use ops::Add
use ops::Sub

pub const PI: f64 = 3.14159265358979323846
pub const E: f64 = 2.71828182845904523536
pub const EPSILON: f64 = 0.0000000000000002220446049250313
pub const INFINITY: f64 = 1.0 / 0.0
pub const NEG_INFINITY: f64 = -1.0 / 0.0
pub const NAN: f64 = 0.0 / 0.0

pub fn is_nan(x: f64) -> bool:
	return x != x

pub fn is_infinite(x: f64) -> bool:
	return x == INFINITY || x == NEG_INFINITY

pub fn is_finite(x: f64) -> bool:
	return x == x && x != INFINITY && x != NEG_INFINITY

extern "C":
	fn c_exp(x: f64) -> f64
	fn c_sqrt(x: f64) -> f64
	fn c_sin(x: f64) -> f64
	fn c_cos(x: f64) -> f64
	fn c_tan(x: f64) -> f64
	fn c_pow(base: f64, exp: f64) -> f64
	fn c_fabs(x: f64) -> f64

pub fn exp(x: f64) -> f64:
	unsafe:
		return c_exp(x)

pub fn sqrt(x: f64) -> f64:
	unsafe:
		return c_sqrt(x)

pub fn sin(x: f64) -> f64:
	unsafe:
		return c_sin(x)

pub fn cos(x: f64) -> f64:
	unsafe:
		return c_cos(x)

pub fn tan(x: f64) -> f64:
	unsafe:
		return c_tan(x)

pub fn pow(base: f64, exponent: f64) -> f64:
	unsafe:
		return c_pow(base, exponent)

pub fn abs(x: f64) -> f64:
	unsafe:
		return c_fabs(x)

pub fn fabs(x: f64) -> f64:
	unsafe:
		return c_fabs(x)


