use std::vec::Vec
use std::fmt::Display
use std::rand::Rng

#[derive(Error)]
pub enum MatrixError:
	#[err("Cannot perform `add` or `sub` on matrices of different dimensions `{0}` and `{1}`")]
	ShapeMismatch((i32, i32), (i32, i32))
	#[err("Cannot multiply matrices with unequal rows & cols `{0}` and `{1}`")]
	MatMulMisalignment((i32, i32), (i32, i32))
	#[err("Cannot construct or update matrix: Expected data length `{0}`, got `{1}`")]
	DataLengthMismatch(i32, i32)
	#[err("Bias matrix must have 1 row & {2} cols. Found {0} rows {1} cols")]
	BroadcastBiasMisalignment(i32, i32, i32)

pub obj Matrix:
	pub rows: i32
	pub cols: i32
	data: Vec<f64>

impl Display for Matrix:
	fn fmt(self) -> String:
		let mut res = String::from("Matrix[\n")
		for r in 0..self.rows:
			res = res.push_str("  [ ")
			for c in 0..self.cols:
				let idx = r * self.cols + c
				let val = self.data[idx]
				res = res.push_str(format!("{}", val))
				res = res.push_str(" ")
			res = res.push_str("]\n")
		res = res.push_str("]")
		return res

impl Matrix:
	pub fn len(&self) -> i32:
		return self.rows * self.cols
	
	fn shapes_match(&self, o: &Matrix) -> Result<(), MatrixError>:
		let shapes = (self.shape(), o.shape())
		if shapes.0 != shapes.1:
			return Err(MatrixError::ShapeMismatch(shapes.0, shapes.1))
		return Ok(())

	// constructors 
	pub fn zeros(rows: i32, cols: i32) -> Matrix {
		let len = rows * cols
		let mut data: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			data.push(0.0)
		return Matrix{ rows: rows, cols: cols, data: data }
	}

	pub fn ones(rows: i32, cols: i32) -> Matrix {
		let len = rows * cols
		let mut data: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			data.push(1.0)
		return Matrix{ rows: rows, cols: cols, data: data }
	}

	pub fn rand(rows: i32, cols: i32) -> Matrix {
		let len = rows * cols
		let mut rng = Rng::new()
		let mut data: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			data.push(rng.next_f64())
		return Matrix{ rows: rows, cols: cols, data: data }
	}

	pub fn from_vec(rows: i32, cols: i32, data: Vec<f64>) -> Result<Matrix, MatrixError>:
		if rows * cols != data.len():
			return Err(MatrixError::DataLengthMismatch(rows * cols, data.len()))
		let m = Matrix{ rows: rows, cols: cols, data: data }
		return Ok(m)

	// accesors 
	pub fn get(&self, r: i32, c: i32) -> f64:
		return self.data[r * self.cols + c]

	pub fn set(&mut self, r: i32, c: i32, val: f64):
		let i = r * self.cols + c
		self.data[i] = val
	
	pub fn shape(&self) -> (i32, i32):
		return (self.rows, self.cols)
		
	// algebra
	pub fn transpose(&self) -> Matrix {
		let data = &self.data
		let mut m = Matrix::zeros(self.cols, self.rows)

		for r in 0..self.rows:
			for c in 0..self.cols:
				let _rc = self.get(r, c)
				m.set(c, r, _rc)
		return m
	}

	pub fn add(&self, o: &Matrix) -> Result<Matrix, MatrixError> {
		self.shapes_match(o)?
		let len = self.len()
		let mut r: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			r.push(self.data[i] + o.data[i])
		let m = Matrix{ rows: self.rows, cols: self.cols, data: r }
		return Ok(m)
	}

	pub fn sub(&self, o: &Matrix) -> Result<Matrix, MatrixError> {
		self.shapes_match(o)?
		let len = self.len()
		let mut r: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			r.push(self.data[i] - o.data[i])
		let m = Matrix{ rows: self.rows, cols: self.cols, data: r }
		return Ok(m)
	}

	pub fn hadamard(&self, o: &Matrix) -> Result<Matrix, MatrixError> {
		self.shapes_match(o)?
		let len = self.len()
		let mut r: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			r.push(self.data[i] * o.data[i])
		let m = Matrix{ rows: self.rows, cols: self.cols, data: r }
		return Ok(m)
	}

	pub fn matmul(&self, o: &Matrix) -> Result<Matrix, MatrixError> {
		if self.cols != o.rows:
			return Err(MatrixError::MatMulMisalignment(self.shape(), o.shape()))
		let mut rm = Matrix::zeros(self.rows, o.cols)
		for r in 0..self.rows:
			for c in 0..o.cols:
				let mut sum: f64 = 0.0
				for k in 0..self.cols:
					sum += self.get(r, k) * o.get(k, c) 
				rm.set(r, c, sum)
		return Ok(rm)
	}

	pub fn scale(&self, s: f64) -> Matrix {
		let len = self.len()
		let mut rv: Vec<f64> = Vec::with_capacity(len)
		for i in 0..len:
			rv.push(self.data[i] * s)
		return Matrix{ rows: self.rows, cols: self.cols, data: rv }
	}

	pub fn add_row(&self, bias: &Matrix) -> Result<Matrix, MatrixError> {
		if bias.rows != 1 || bias.cols != self.cols:
			return Err(MatrixError::BroadcastBiasMisalignment(bias.rows, bias.cols, self.cols))
		let mut rm = Matrix::zeros(self.rows, self.cols)

		for r in 0..self.rows:
			for c in 0..self.cols:
				let bv = bias.get(0, c)
				let val = self.get(r, c)
				let sum = bv + val
				rm.set(r, c, sum)
		return Ok(rm)
	}

	pub fn sub_rows(&self, bias: &Matrix) -> Result<Matrix, MatrixError> {
		if bias.rows != 1 || bias.cols != self.cols:
			return Err(MatrixError::BroadcastBiasMisalignment(bias.rows, bias.cols, self.cols))
		let mut rm = Matrix::zeros(self.rows, self.cols)

		for r in 0..self.rows:
			for c in 0..self.cols:
				let bv = bias.get(0, c)
				let val = self.get(r, c)
				let sum = bv - val
				rm.set(r, c, sum)
		return Ok(rm)
	}

