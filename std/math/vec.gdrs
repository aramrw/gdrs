pub obj Vec2 where $T: Add:
	pub x: $T
	pub y: $T

impl Vec2:
	pub fn new(x: $T, y: $T) -> Vec2:
		Vec2{x: x, y: y}

impl Add for Vec2 where $T: Add: 
	fn add(self, other: Vec2) -> Vec2:
		let x = self.x + other.x
		let y = self.y + other.y
		return self.new(x, y)

impl Sub for Vec2 where $T: Sub: 
	fn sub(self, other: Vec2) -> Vec2:
		let x = self.x - other.x
		let y = self.y - other.y
		return self.new(x, y)

pub obj Vec3 where $T: Add:
	pub x: $T
	pub y: $T
	pub z: $T

impl Vec3:
	pub fn new(x: $T, y: $T, z: $T) -> Vec3:
		Vec3{x: x, y: y, z: z}

impl Add for Vec3: 
	fn add(self, other: Vec3) -> Vec3:
		let x = self.x + other.x
		let y = self.y + other.y
		let z = self.z + other.z
		return self.new(x, y, z)

impl Sub for Vec3: 
	fn sub(self, other: Vec3) -> Vec3:
		let x = self.x - other.x
		let y = self.y - other.y
		let z = self.z - other.z
		return self.new(x, y, z)

