// std/env.gdrs - Environment variables and CLI arguments module
use std::core::{Option, Result}
use std::libc::{getenv, setenv, unsetenv}
use std::string::String

extern "C":
	fn intrinsic_arg_count() -> i64
	fn intrinsic_arg_at(idx: i64) -> str

enum VarError:
	NotPresent
	NotUnicode

obj Args:
	idx: i64
	count: i64

impl Args:
	fn new() -> Args:
		unsafe:
			let cnt = intrinsic_arg_count()
			return Args{ idx: 0, count: cnt }

	// Takes &mut self so the caller retains ownership across iteration loops
	fn next(&mut self) -> Option<String>:
		if self.idx < self.count:
			unsafe:
				let s = intrinsic_arg_at(self.idx)
				self.idx = self.idx + 1
				return Option::Some(String::from(s))
		return Option::None

	// Returns remaining items count, consistent with ExactSizeIterator
	fn len(&self) -> i64:
		return self.count - self.idx

fn args() -> Args:
	return Args::new()

fn var(key: str) -> Result<String, VarError>:
	unsafe:
		match getenv(key):
			Option::None =>
				return Result::Err(VarError::NotPresent)
			Option::Some(p) =>
				return Result::Ok(String::from(p as str))

fn set_var(key: str, value: str):
	unsafe:
		setenv(key, value, 1)

fn remove_var(key: str):
	unsafe:
		unsetenv(key)
