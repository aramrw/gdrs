// imp.gdrs - Low-level Unix process runner using libc

extern "C":
	fn fork() -> i32
	fn execvp(file: str, argv: i64) -> i32
	fn waitpid(pid: i32, status_ptr: i64, options: i32) -> i32

obj ImpCommand:
	program: String

fn spawn_and_wait(program: String) -> i32:
	unsafe:
		let pid = fork()

		if pid == 0:
			// replaces child w/ target program
			execvp(program, 0)

			// if execvp returns, exe failed
			return -1

		else if pid > 0:
			let mut status: i64 = 0
			waitpid(pid, status, 0)
			return 0
		
		else:
			return -1
