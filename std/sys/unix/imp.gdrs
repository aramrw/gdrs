// imp.gdrs - Low-level Unix process runner using libc

extern "C":
	fn fork() -> i32
	fn intrinsic_execvp(file: str) -> i32
	fn intrinsic_waitpid(pid: i32) -> i32

pub obj ImpCommand:
	program: str

impl ImpCommand:
	pub fn spawn(program: str) -> i32:
		unsafe:
			let pid = fork()

			if pid == 0:
				intrinsic_execvp(program)
				return -1
			else:
				if pid > 0:
					return intrinsic_waitpid(pid)
				else:
					return -1
