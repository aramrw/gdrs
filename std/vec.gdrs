// std/vec.gdrs - Heap allocated Vec collection using libc
use std::libc::{malloc, realloc, free}
use std::core::{Option, Drop}

obj Vec:
	ptr: *i64
	len: i64
	cap: i64

obj VecIter:
	vec_ptr: *i64
	idx: i64
	len: i64

impl Drop for Vec:
	fn drop(mut self):
		unsafe:
			if (self.ptr as i64) != 0:
				free(self.ptr as *void)
				self.ptr = 0 as *i64
				self.len = 0
				self.cap = 0

impl Vec:
	fn new() -> Vec:
		return Vec{ ptr: 0 as *i64, len: 0, cap: 0 }

	fn push(mut self, elem: i64) -> Vec:
		unsafe:
			if self.cap == 0:
				self.cap = 4
				match malloc(self.cap * 8):
					Option::Some(p) =>
						self.ptr = p as *i64
					Option::None =>
						return self
			if self.len >= self.cap:
				self.cap = self.cap * 2
				match realloc(self.ptr as *void, self.cap * 8):
					Option::Some(p) =>
						self.ptr = p as *i64
					Option::None =>
						return self
			let slot = self.ptr + self.len
			*slot = elem
		self.len = self.len + 1
		return self

	fn pop(mut self) -> Option<i64>:
		if self.len == 0:
			return Option::None
		self.len = self.len - 1
		let slot = self.ptr + self.len
		let mut val = 0
		unsafe:
			val = *slot
		return Option::Some(val)

	fn len(self) -> i64:
		return self.len

	fn is_empty(self) -> bool:
		return self.len == 0

	fn into_iter(self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

	fn iter(self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

impl VecIter:
	fn into_iter(self) -> VecIter:
		return self

	fn iter(self) -> VecIter:
		return self

	fn next(mut self) -> Option<i64>:
		if self.idx < self.len:
			let slot = self.vec_ptr + self.idx
			let mut val = 0
			unsafe:
				val = *slot
			self.idx = self.idx + 1
			return Option::Some(val)
		return Option::None

