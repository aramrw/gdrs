// std/vec.gdrs - Heap allocated Vec collection using libc

obj Vec:
	ptr: i64
	len: i64
	cap: i64

obj VecIter:
	vec_ptr: i64
	idx: i64
	len: i64

impl Vec:
	fn new() -> Vec:
		return Vec{ ptr: 0, len: 0, cap: 0 }

	fn push(mut self, elem: i64) -> Vec:
		unsafe:
			if self.cap == 0:
				self.cap = 4
				self.ptr = malloc(self.cap * 8)
			if self.len >= self.cap:
				self.cap = self.cap * 2
				self.ptr = realloc(self.ptr, self.cap * 8)
			let offset = self.len * 8
			let slot = self.ptr + offset
			*slot = elem
		self.len = self.len + 1
		return self

	fn pop(mut self) -> Option<i64>:
		if self.len == 0:
			return Option::None
		self.len = self.len - 1
		let offset = self.len * 8
		let slot = self.ptr + offset
		let mut val = 0
		unsafe:
			val = *slot
		return Option::Some(val)

	fn len(self) -> i64:
		return self.len

	fn is_empty(self) -> bool:
		return self.len == 0

	fn iter(self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

impl VecIter:
	fn iter(self) -> VecIter:
		return self

	fn next(mut self) -> Option<i64>:
		if self.idx < self.len:
			let slot = self.vec_ptr + (self.idx * 8)
			let mut val = 0
			unsafe:
				val = *slot
			self.idx = self.idx + 1
			return Option::Some(val)
		return Option::None
