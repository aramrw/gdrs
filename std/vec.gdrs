// std/vec.gdrs - Heap allocated Vec collection using libc
use std::libc::{malloc, realloc, free}
use std::core::{Option, Drop}

obj Vec:
	ptr: *u8
	len: i64
	cap: i64

obj VecIter:
	vec_ptr: *u8
	idx: i64
	len: i64

impl Drop for Vec:
	fn drop(mut self):
		unsafe:
			if (self.ptr as u64) != 0:
				free(self.ptr as *void)
				self.ptr = 0 as *u8
				self.len = 0
				self.cap = 0

impl Vec:
	fn new() -> Vec:
		return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }

	fn with_capacity(capacity: i64) -> Vec:
		if capacity <= 0:
			return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
		unsafe:
			let elem_size = ((0 as *$T) + 1) as i64
			if elem_size == 0:
				return Vec{ ptr: 0 as *u8, len: 0, cap: 9223372036854775807 }
			let p = malloc(capacity * elem_size)
			if (p as u64) == 0:
				return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
			return Vec{ ptr: p as *u8, len: 0, cap: capacity }

	fn capacity(&self) -> i64:
		return self.cap

	fn from_slice(slice: [$T]) -> Vec:
		if slice.len <= 0:
			return Vec::new()
		unsafe:
			let elem_size = ((0 as *$T) + 1) as i64
			let mut v = Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
			if elem_size == 0:
				v.cap = 9223372036854775807
			else:
				let p = malloc(slice.len * elem_size)
				if (p as u64) != 0:
					v.ptr = p as *u8
					v.cap = slice.len
			let mut i = 0
			while i < slice.len:
				v.push(slice[i])
				i = i + 1
			return v

	fn push(&mut self, elem: $T):
		unsafe:
			let elem_size = ((0 as *$T) + 1) as i64
			if elem_size == 0:
				if self.cap == 0:
					self.cap = 9223372036854775807
			else:
				if self.len >= self.cap:
					let mut new_cap = 4
					if self.cap > 0:
						new_cap = self.cap * 2
					if new_cap <= self.cap:
						return
					let p = realloc(self.ptr as *void, new_cap * elem_size)
					if (p as u64) == 0:
						return
					self.ptr = p as *u8
					self.cap = new_cap
			let slot = (self.ptr as *$T) + self.len
			*slot = elem
		self.len = self.len + 1

	fn pop(&mut self) -> Option<$T>:
		if self.len == 0:
			return Option::None
		self.len = self.len - 1
		unsafe:
			let slot = (self.ptr as *$T) + self.len
			return Option::Some(*slot)

	fn len(&self) -> i64:
		return self.len

	fn is_empty(&self) -> bool:
		return self.len == 0

	fn into_iter(&self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

	fn iter(&self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

impl VecIter:
	fn into_iter(self) -> VecIter:
		return self

	fn iter(self) -> VecIter:
		return self

	fn next(&mut self) -> Option<$T>:
		if self.idx < self.len:
			let idx = self.idx
			self.idx = idx + 1
			unsafe:
				let slot = (self.vec_ptr as *$T) + idx
				return Option::Some(*slot)
		return Option::None

