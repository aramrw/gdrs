// std/vec.gdrs - Heap allocated Vec collection using libc
use std::libc::{malloc, realloc, free, memmove}
use std::core::{Option, Drop}
use std::mem::{size_of, drop}
use std::iter::{Map, Filter, FilterMap}

pub obj Vec:
	ptr: *u8
	len: i64
	cap: i64

pub obj VecIter:
	vec_ptr: *u8
	idx: i64
	len: i64

pub obj VecRefIter:
	vec_ptr: *u8
	idx: i64
	len: i64

impl Drop for Vec:
	fn drop(mut self):
		unsafe:
			if (self.ptr as u64) != 0:
				free(self.ptr as *void)
				self.ptr = 0 as *u8
				self.len = 0
				self.cap = 0

impl Vec:
	pub fn new() -> Vec:
		return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }

	pub fn with_capacity(capacity: i64) -> Vec:
		if capacity <= 0:
			return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
		unsafe:
			let elem_size = size_of::<$T>()
			if elem_size == 0:
				return Vec{ ptr: 0 as *u8, len: 0, cap: 9223372036854775807 }
			if capacity > (9223372036854775807 / elem_size):
				return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
			let p = malloc(capacity * elem_size)
			if (p as u64) == 0:
				return Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
			return Vec{ ptr: p as *u8, len: 0, cap: capacity }

	pub fn capacity(&self) -> i64:
		return self.cap

	pub fn as_ptr(&self) -> *$T:
		return self.ptr as *$T

	pub fn as_mut_ptr(&mut self) -> *$T:
		return self.ptr as *$T

	pub fn from_raw_parts(ptr: *$T, len: i64, cap: i64) -> Vec:
		return Vec{ ptr: ptr as *u8, len: len, cap: cap }

	pub fn from_slice(slice: [$T]) -> Vec:
		if slice.len <= 0:
			return Vec::new()
		unsafe:
			let elem_size = size_of::<$T>()
			let mut v = Vec{ ptr: 0 as *u8, len: 0, cap: 0 }
			if elem_size == 0:
				v.cap = 9223372036854775807
			else:
				if slice.len > (9223372036854775807 / elem_size):
					return v
				let p = malloc(slice.len * elem_size)
				if (p as u64) == 0:
					return v
				v.ptr = p as *u8
				v.cap = slice.len
			let mut i = 0
			while i < slice.len:
				v.push(slice[i])
				i = i + 1
			return v

	pub fn push(&mut self, elem: $T):
		unsafe:
			let elem_size = size_of::<$T>()
			if elem_size == 0:
				if self.cap == 0:
					self.cap = 9223372036854775807
			else:
				if self.len >= self.cap:
					let mut new_cap = 4
					if self.cap > 0:
						if self.cap > (9223372036854775807 / 2):
							return
						new_cap = self.cap * 2
					if new_cap <= self.cap || new_cap > (9223372036854775807 / elem_size):
						return
					let p = realloc(self.ptr as *void, new_cap * elem_size)
					if (p as u64) == 0:
						return
					self.ptr = p as *u8
					self.cap = new_cap
			let slot = (self.ptr as *$T) + self.len
			*slot = elem
		self.len = self.len + 1

	pub fn pop(&mut self) -> Option<$T>:
		if self.len == 0:
			return Option::None
		self.len = self.len - 1
		unsafe:
			let slot = (self.ptr as *$T) + self.len
			return Option::Some(*slot)

	pub fn len(&self) -> i64:
		return self.len

	pub fn is_empty(&self) -> bool:
		return self.len == 0

	pub fn get(&self, idx: i64) -> Option<&$T>:
		if idx < 0 || idx >= self.len:
			return Option::None
		unsafe:
			let slot = (self.ptr as *$T) + idx
			return Option::Some(slot as &$T)

	pub fn get_mut(&mut self, idx: i64) -> Option<&mut $T>:
		if idx < 0 || idx >= self.len:
			return Option::None
		unsafe:
			let slot = (self.ptr as *$T) + idx
			return Option::Some(slot as &mut $T)

	pub fn remove(&mut self, idx: i64) -> Option<$T>:
		if idx < 0 || idx >= self.len:
			return Option::None
		unsafe:
			let elem_size = size_of::<$T>()
			let target_slot = (self.ptr as *$T) + idx
			let removed = *target_slot
			let tail_count = self.len - idx - 1
			if tail_count > 0 && elem_size > 0:
				let base = self.ptr as i64
				let dst = (base + idx * elem_size) as *void
				let src = (base + (idx + 1) * elem_size) as *void
				memmove(dst, src, tail_count * elem_size)
			self.len = self.len - 1
			return Option::Some(removed)

	pub fn clear(&mut self):
		unsafe:
			let mut i: i64 = 0
			while i < self.len:
				let slot = (self.ptr as *$T) + i
				drop(*slot)
				i = i + 1
		self.len = 0

	pub fn into_iter(&self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

	pub fn iter(&self) -> VecIter:
		return VecIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

	pub fn iter_ref(&self) -> VecRefIter:
		return VecRefIter{ vec_ptr: self.ptr, idx: 0, len: self.len }

impl VecRefIter:
	pub fn into_iter(self) -> VecRefIter:
		return self

	pub fn iter(self) -> VecRefIter:
		return self

	pub fn next(&mut self) -> Option<&$T>:
		if self.idx < self.len:
			let idx = self.idx
			self.idx = idx + 1
			unsafe:
				let slot = (self.vec_ptr as *$T) + idx
				return Option::Some(slot as &$T)
		return Option::None

impl VecIter:
	pub fn into_iter(self) -> VecIter:
		return self

	pub fn iter(self) -> VecIter:
		return self

	pub fn next(&mut self) -> Option<$T>:
		if self.idx < self.len:
			let idx = self.idx
			self.idx = idx + 1
			unsafe:
				let slot = (self.vec_ptr as *$T) + idx
				return Option::Some(*slot)
		return Option::None

	pub fn map(self, f: $F) -> Map<Self, $F>:
		return Map{ iter: self, func: f }

	pub fn filter(self, pred: $P) -> Filter<Self, $P>:
		return Filter{ iter: self, pred: pred }

	pub fn filter_map(self, f: $F) -> FilterMap<Self, $F>:
		return FilterMap{ iter: self, func: f }

	pub fn fold(mut self, init: $Acc, f: $F) -> $Acc:
		let mut acc = init
		while true:
			if let Option::Some(x) = self.next():
				acc = f(acc, x)
			else:
				return acc
		return acc

	pub fn reduce(mut self, f: $F) -> Option<$T>:
		if let Option::Some(first) = self.next():
			let mut acc = first
			while true:
				if let Option::Some(x) = self.next():
					acc = f(acc, x)
				else:
					return Option::Some(acc)
			return Option::Some(acc)
		return Option::None

	pub fn collect(mut self) -> Vec<$T>:
		let mut out = Vec::new()
		while true:
			if let Option::Some(x) = self.next():
				out.push(x)
			else:
				return out
		return out

