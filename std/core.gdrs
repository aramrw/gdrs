// std/core.gdrs - Core standard library types and traits

pub trait Drop:
	fn drop(mut self)

pub trait PartialEq:
	fn eq(&self, other: &Self) -> bool

pub trait Eq {}

pub trait Hash:
	fn hash(&self) -> u64

fn mix_u64(val: u64) -> u64:
	let mut z = val
	z = (z ^ (z >> (30 as u64))) * (13787848793156543929 as u64)
	z = (z ^ (z >> (27 as u64))) * (10723151780598845931 as u64)
	return z ^ (z >> (31 as u64))

impl PartialEq for i64:
	pub fn eq(&self, other: &i64) -> bool:
		return *self == *other

impl Hash for i64:
	pub fn hash(&self) -> u64:
		return mix_u64(*self as u64)

impl PartialEq for i32:
	pub fn eq(&self, other: &i32) -> bool:
		return *self == *other

impl Hash for i32:
	pub fn hash(&self) -> u64:
		return mix_u64((*self as i64) as u64)

impl PartialEq for u64:
	pub fn eq(&self, other: &u64) -> bool:
		return *self == *other

impl Hash for u64:
	pub fn hash(&self) -> u64:
		return mix_u64(*self)

impl PartialEq for u8:
	pub fn eq(&self, other: &u8) -> bool:
		return *self == *other

impl Hash for u8:
	pub fn hash(&self) -> u64:
		return mix_u64(*self as u64)

impl PartialEq for bool:
	pub fn eq(&self, other: &bool) -> bool:
		return *self == *other

impl Hash for bool:
	pub fn hash(&self) -> u64:
		let v: u64 = if *self: 1 as u64 else: 0 as u64
		return mix_u64(v)

#[derive(Debug)]
pub enum Option:
	Some($T)
	None

impl Option:
	pub fn is_some(&self) -> bool:
		match self:
			Option::Some(_) => true
			Option::None => false

	pub fn is_none(&self) -> bool:
		match self:
			Option::Some(_) => false
			Option::None => true

	#[track_caller]
	pub fn unwrap(self) -> $T:
		match self:
			Option::Some(val) => val
			Option::None => panic!("called `Option::unwrap()` on a `None` value")

	#[track_caller]
	pub fn expect(self, msg: str) -> $T:
		match self:
			Option::Some(val) => val
			Option::None => panic!("{}", msg)

#[derive(Debug)]
pub enum Result:
	Ok($T)
	Err($E)

impl Result:
	pub fn is_ok(&self) -> bool:
		match self:
			Result::Ok(_) => true
			Result::Err(_) => false

	pub fn is_err(&self) -> bool:
		match self:
			Result::Ok(_) => false
			Result::Err(_) => true

	#[track_caller]
	pub fn unwrap(self) -> $T where $E: Debug:
		match self:
			Result::Ok(val) => val
			Result::Err(err) => panic!("called `Result::unwrap()` on an `Err` value: {:?}", err)

	#[track_caller]
	pub fn expect(self, msg: str) -> $T where $E: Debug:
		match self:
			Result::Ok(val) => val
			Result::Err(err) => panic!("{}: {:?}", msg, err)

	#[track_caller]
	pub fn unwrap_err(self) -> $E where $T: Debug:
		match self:
			Result::Ok(val) => panic!("called `Result::unwrap_err()` on an `Ok` value: {:?}", val)
			Result::Err(err) => err

	#[track_caller]
	pub fn expect_err(self, msg: str) -> $E where $T: Debug:
		match self:
			Result::Ok(val) => panic!("{}: {:?}", msg, val)
			Result::Err(err) => err
