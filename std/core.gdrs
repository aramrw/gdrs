// std/core.gdrs - Core standard library types and traits

pub trait Drop:
	fn drop(mut self)

pub trait PartialEq:
	fn eq(&self, other: &Self) -> bool

pub trait Eq {}

#[derive(Debug)]
pub enum Option:
	Some($T)
	None

impl Option:
	pub fn is_some(&self) -> bool:
		match self:
			Option::Some(_) => true
			Option::None => false

	pub fn is_none(&self) -> bool:
		match self:
			Option::Some(_) => false
			Option::None => true

	#[track_caller]
	pub fn unwrap(self) -> $T:
		match self:
			Option::Some(val) => val
			Option::None => panic!("called `Option::unwrap()` on a `None` value")

	#[track_caller]
	pub fn expect(self, msg: str) -> $T:
		match self:
			Option::Some(val) => val
			Option::None => panic!("{}", msg)

#[derive(Debug)]
pub enum Result:
	Ok($T)
	Err($E)

impl Result:
	pub fn is_ok(&self) -> bool:
		match self:
			Result::Ok(_) => true
			Result::Err(_) => false

	pub fn is_err(&self) -> bool:
		match self:
			Result::Ok(_) => false
			Result::Err(_) => true

	#[track_caller]
	pub fn unwrap(self) -> $T where $E: Debug:
		match self:
			Result::Ok(val) => val
			Result::Err(err) => panic!("called `Result::unwrap()` on an `Err` value: {:?}", err)

	#[track_caller]
	pub fn expect(self, msg: str) -> $T where $E: Debug:
		match self:
			Result::Ok(val) => val
			Result::Err(err) => panic!("{}: {:?}", msg, err)

	#[track_caller]
	pub fn unwrap_err(self) -> $E where $T: Debug:
		match self:
			Result::Ok(val) => panic!("called `Result::unwrap_err()` on an `Ok` value: {:?}", val)
			Result::Err(err) => err

	#[track_caller]
	pub fn expect_err(self, msg: str) -> $E where $T: Debug:
		match self:
			Result::Ok(val) => panic!("{}: {:?}", msg, val)
			Result::Err(err) => err
