// std/core.gdrs - Core standard library types and traits

pub trait Drop:
	fn drop(mut self)

pub trait PartialEq:
	fn eq(&self, other: &Self) -> bool

pub trait Eq {}

pub enum Option:
	Some($T)
	None

impl Option:
	pub fn is_some(&self) -> bool:
		match self:
			Option::Some(_) => true
			Option::None => false

	pub fn is_none(&self) -> bool:
		match self:
			Option::Some(_) => false
			Option::None => true

	#[track_caller]
	pub fn unwrap(self) -> $T:
		match self:
			Option::Some(val) => val
			Option::None => panic!("called `Option::unwrap()` on a `None` value")

pub enum Result:
	Ok($T)
	Err($E)

impl Result:
	pub fn is_ok(&self) -> bool:
		match self:
			Result::Ok(_) => true
			Result::Err(_) => false

	pub fn is_err(&self) -> bool:
		match self:
			Result::Ok(_) => false
			Result::Err(_) => true

	#[track_caller]
	pub fn unwrap(self) -> $T:
		match self:
			Result::Ok(val) => val
			Result::Err(err) => panic!("called `Result::unwrap()` on an `Err` value")
