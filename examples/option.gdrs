use std::core::{Result as Res, Option as Opt}

fn find_even(val: i64) -> Opt<i64>:
	if val % 2 == 0:
		return Opt::Some(val)
	else:
		return Opt::None

fn double_even(val: i64) -> Opt<i64>:
	let even = find_even(val)?
	return Opt::Some(even * 2)

fn main():
	log!("--- Testing Multi Imports with aliases ---")

	let d1 = double_even(15)
	log!("double_even(15).is_none():", d1.is_none())

	let none = None
	log!("let none = None: ", none.is_none())

	let some = Some(1)
	log!("some.is_some(): ", some.is_some())

	let res = Res::Ok(777)
	log!("res.unwrap():", res.unwrap())

// Output:
// --- Testing Multi Imports with aliases ---
// double_even(15).is_none():
// true
// let none = None: 
// true
// some.is_some(): 
// true
// res.unwrap():
// 777
