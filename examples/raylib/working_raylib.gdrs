use std::math::Vec2

extern "C":
	fn dlopen(filename: str, flags: i32) -> i64

	fn InitWindow(width: i32, height: i32, title: str)
	fn WindowShouldClose() -> bool
	fn BeginDrawing()
	fn ClearBackground(color_hex: i32)
	// Match Raylib C ABI: int, int, float, Color(i32)
	fn DrawCircle(centerX: i32, centerY: i32, radius: f32, color_hex: i32)
	fn EndDrawing()
	fn CloseWindow()
	fn SetTargetFPS(fps: i32)
	fn GetScreenWidth() -> i32
	fn GetScreenHeight() -> i32

obj Ball:
	pos: Vec2
	speed: Vec2
	r: f32
	color: i32

fn main():
	unsafe:
		let handle = dlopen("/opt/homebrew/lib/libraylib.dylib", 9)
		if handle == 0:
			log!("Failed to load Raylib!")
			return

		InitWindow(800, 600, "GDRS Bouncing Circle!")
		SetTargetFPS(60)

		let bounds = Vec2.new(GetScreenWidth(), GetScreenHeight())

		let mut pos1 = Vec2.new(400.0, 300.0)
		let mut speed1 = Vec2.new(5.0, 5.0)

		let mut pos2 = Vec2.new(200.0, 150.0)
		let mut speed2 = Vec2.new(-3.0, 4.0)

		while !WindowShouldClose():
			BeginDrawing()
			ClearBackground(2294467295)

			// --- Ball 1 Update ---
			pos1.x += speed1.x
			pos1.y += speed1.y

			if pos1.x >= (bounds.x - 50.0):
				pos1.x = bounds.x - 50.0
				speed1.x = -speed1.x
			if pos1.x <= 50.0:
				pos1.x = 50.0
				speed1.x = -speed1.x

			if pos1.y >= (bounds.y - 50.0):
				pos1.y = bounds.y - 50.0
				speed1.y = -speed1.y
			if pos1.y <= 50.0:
				pos1.y = 50.0
				speed1.y = -speed1.y

			// --- Ball 2 Update ---
			pos2.x += speed2.x
			pos2.y += speed2.y

			if pos2.x >= (bounds.x - 30.0):
				pos2.x = bounds.x - 30.0
				speed2.x = -speed2.x
			if pos2.x <= 30.0:
				pos2.x = 30.0
				speed2.x = -speed2.x

			if pos2.y >= (bounds.y - 30.0):
				pos2.y = bounds.y - 30.0
				speed2.y = -speed2.y
			if pos2.y <= 30.0:
				pos2.y = 30.0
				speed2.y = -speed2.y

			// Draw Ball 1 & 2
			DrawCircle(pos1.x, pos1.y, 50.0, 4278190335)
			DrawCircle(pos2.x, pos2.y, 30.0, 4294902015)

			EndDrawing()

		CloseWindow()
