use std::math::Vec2
use std::time::Instant

extern "C":
	fn dlopen(filename: str, flags: i32) -> i64

	fn InitWindow(width: i32, height: i32, title: str)
	fn WindowShouldClose() -> bool
	fn BeginDrawing()
	fn ClearBackground(color_hex: i32)
	fn DrawCircle(centerX: i32, centerY: i32, radius: f32, color_hex: i32)
	fn EndDrawing()
	fn CloseWindow()
	fn SetTargetFPS(fps: i32)
	fn GetScreenWidth() -> i32
	fn GetScreenHeight() -> i32

obj Ball:
	pos: Vec2
	speed: Vec2
	r: f32
	color: i32

impl Ball:
	fn update(&mut self):
		self.pos.x += self.speed.x
		self.pos.y += self.speed.y

	fn bounds_check_x(&mut self):
		unsafe:
			let screen_w = GetScreenWidth()
			if self.pos.x >= (screen_w - self.r):
				self.pos.x = screen_w - self.r
				if self.speed.x > 0.0:
					self.speed.x = -self.speed.x

			if self.pos.x <= self.r:
				self.pos.x = self.r
				if self.speed.x < 0.0:
					self.speed.x = -self.speed.x

	fn bounds_check_y(&mut self):
		unsafe:
			let screen_h = GetScreenHeight()
			if self.pos.y >= (screen_h - self.r):
				self.pos.y = screen_h - self.r
				if self.speed.y > 0.0:
					self.speed.y = -self.speed.y

			if self.pos.y <= self.r:
				self.pos.y = self.r
				if self.speed.y < 0.0:
					self.speed.y = -self.speed.y

fn main():
	unsafe:
		let handle = dlopen("/opt/homebrew/lib/libraylib.dylib", 9)
		if handle == 0:
			log!("Failed to load Raylib!")
			return

		InitWindow(800, 600, "GDRS Bouncing Circle!")
		SetTargetFPS(60)

		let mut balls = []

		let mut i = 0
		while i < 10:
			let pos = Vec2.new(50.0 + (70.0 * i), 100.0 + (40.0 * i))
			let mut vx = 3.0 + i
			let mut vy = 4.0 - i
			if (i % 2) == 0:
				vx = -vx
			let speed = Vec2.new(vx, vy)

			let mut radius = 15.0
			if (i % 2) == 0:
				radius = 25.0
			else:
				radius = 10.0 + (2.0 * i)

			let mut col = 4278190335
			if (i % 3) == 1:
				col = 16711935
			if (i % 3) == 2:
				col = 65535

			let ball = Ball{pos: pos, speed: speed, r: radius, color: col}
			balls = balls.push(ball)
			i += 1

		while !WindowShouldClose():
			BeginDrawing()
			ClearBackground(2294467295)

			let mut idx = 0
			while idx < balls.len():
				let mut ball = balls[idx]
				ball.update()
				ball.bounds_check_x()
				ball.bounds_check_y()

				DrawCircle(ball.pos.x, ball.pos.y, ball.r, ball.color)
				idx += 1

			EndDrawing()

		CloseWindow()
