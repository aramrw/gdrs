use std::math::Vec2
use std::math::Vec3

fn main():
	let v1 = Vec2.new(5.0, 5.0)
	let v2 = Vec2.new(5.0, 5.0)

	let res1 = v1.add(v2)
	log!("v1.add(v2):", res1)

	let res2 = v1 + v2
	log!("v1 + v2:", res2)

	let v3 = Vec3.new(1.0, 2.0, 3.0)
	let v4 = Vec3.new(4.0, 5.0, 6.0)
	let res3 = v3 + v4
	log!("v3 + v4:", res3)

