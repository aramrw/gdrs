use std::math::Vec2

extern "C":
	fn dlopen(filename: str, flags: i32) -> i64

	fn InitWindow(width: i32, height: i32, title: str)
	fn WindowShouldClose() -> bool
	fn BeginDrawing()
	fn ClearBackground(color_hex: i64)
	fn DrawCircle(centerX: i32, centerY: i32, radius: f32, color_hex: i64)
	fn EndDrawing()
	fn CloseWindow()
	fn SetTargetFPS(fps: i32)
	fn GetScreenWidth() -> i32
	fn GetScreenHeight() -> i32

obj Ball:
	pos: Vec2
	speed: Vec2
	r: f32
	color: i32

fn main():
	unsafe:
		let handle = dlopen("/opt/homebrew/lib/libraylib.dylib", 9)
		if handle == 0:
			log!("Failed to load Raylib!")
			return

		InitWindow(800, 600, "GDRS Bouncing Circle!")
		SetTargetFPS(60)

		let pos = Vec2.new(400.0, 300.0)
		let speed = Vec2.new(5.0, 5.0)
		let mut ball = Ball{pos: pos, speed: speed, r: 50.0, color: 4278190335}

		while !WindowShouldClose():
			let bounds = Vec2.new(GetScreenWidth(), GetScreenHeight())

			ball.pos.x = ball.pos.x + ball.speed.x
			ball.pos.y = ball.pos.y + ball.speed.y

			if ball.pos.x >= (bounds.x - ball.r):
				ball.pos.x = bounds.x - ball.r
				ball.speed.x = -ball.speed.x

			if ball.pos.x <= ball.r:
				ball.pos.x = ball.r
				ball.speed.x = -ball.speed.x

			if ball.pos.y >= (bounds.y - ball.r):
				ball.pos.y = bounds.y - ball.r
				ball.speed.y = -ball.speed.y

			if ball.pos.y <= ball.r:
				ball.pos.y = ball.r
				ball.speed.y = -ball.speed.y

			BeginDrawing()
			ClearBackground(2294467295)
			DrawCircle(ball.pos.x, ball.pos.y, ball.r, ball.color)
			EndDrawing()

		CloseWindow()
