use std::math::Vec2

extern "C":
	fn dlopen(filename: str, flags: i32) -> i64

	fn InitWindow(width: i32, height: i32, title: str)
	fn WindowShouldClose() -> bool
	fn BeginDrawing()
	fn ClearBackground(color_hex: i64)
	fn DrawCircle(centerX: i32, centerY: i32, radius: f32, color_hex: i64)
	fn EndDrawing()
	fn CloseWindow()
	fn SetTargetFPS(fps: i32)
	fn GetWindowWidth()
	fn GetWindowHeight()

fn main():
	unsafe:
		let handle = dlopen("/opt/homebrew/lib/libraylib.dylib", 9)
		if handle == 0:
			log!("Failed to load Raylib!")
			return

		InitWindow(800, 600, "GDRS Bouncing Circle!")
		SetTargetFPS(60)

		let mut x = 400.0
		let mut y = 300.0
		let mut speed_x = 5
		let mut speed_y = 5
		let radius = 50.0

		while !WindowShouldClose():
			let bounds = Vec2.new(GetWindowWidth(), GetWindowHeight())

			x += speed_x
			y += speed_y

			if x >= (bounds.x - radius):
				x = bounds.x - radius
				speed_x = -speed_x

			if x <= radius:
				x = radius
				speed_x = -speed_x

			if y >= (bounds.y - radius):
				y = bounds.y - radius
				speed_y = -speed_y

			if y <= radius:
				y = radius
				speed_y = -speed_y

			BeginDrawing()
			ClearBackground(2294467295)
			DrawCircle(x, y, 50.0, 4278190335)
			EndDrawing()

		CloseWindow()
