fn main():
	// Inferred types (default 64-bit literals)
	let a = 42           // i64 (default)
	let b = 3.14         // f64 (default)

	// Explicit annotations
	let c: i32 = 100
	let d: i64 = 9000000000
	let e: f32 = 3.14
	let f: f64 = 2.718281828

	log!("a (inferred i64): {}", a)
	log!("b (inferred f64): {}", b)
	log!("c (explicit i32): {}", c)
	log!("d (explicit i64): {}", d)
	log!("e (explicit f32): {}", e)
	log!("f (explicit f64): {}", f)
	log!("{} {} {} {} {} {}", typeof!(a), typeof!(b), typeof!(c), typeof!(d), typeof!(e), typeof!(f))

	// Arithmetic with typed values
	let sum_i32: i32 = c + a
	log!("sum i32: {}", sum_i32)

	let sum_i64: i64 = d + 1
	log!("sum i64: {}", sum_i64)
