use std::math::matrix::Matrix
use std::math::matrix::MatrixError
use std::vec::Vec

fn add():
	// manual init
	let mut m1 = Matrix::zeros(2, 2)
	m1.set(1, 0, 20.0)

	let mut m2 = Matrix::zeros(2, 2)
	m2.set(1, 0, 20.0)
	let r2_c1 = m2.get(1, 0)
	assert!(r2_c1 == 20.0)

	let m3 = m1.add(&m2).unwrap()
	log!("{}", &m3.fmt())

fn mismatched_shape() -> Result<Matrix, MatrixError>:
	let m1 = Matrix::ones(2, 2)
	let m2 = Matrix::ones(6, 6)
	m1.add(&m2)

fn matmul():
	let v1: Vec<f64> = vec![0.0, 1.0, 2.0]
	let v2: Vec<f64> = vec![0.0, 10.0, 20.0]
	let m1 = Matrix::from_vec(1, 3, v1).unwrap()
	let m2 = Matrix::from_vec(3, 2, v2).unwrap()
	let r = m1.matmul(&m2)
	if let Err(e) = r:
		log!("{}", e)
	
fn main():
	add()

	// this should error
	match mismatched_shape():
		Ok(_) => log!("valid")
		Err(e) => log!("{}", e.fmt())

	matmul()


