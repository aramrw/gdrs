use std::fs::File
use std::time::Instant

fn read_file_test() -> Result<String>:
	let file = File::open("./examples/read_file.gdrs")?
	let contents = file.read_to_string()?
	return Ok(contents)

fn main():
	log!("--- Benchmarking std::fs::File read using std::time::Instant ---")

	let start = Instant::now()

	let res = read_file_test()

	let elapsed_us = start.us()
	let elapsed_ms = start.ms()

	if res.is_ok():
		log!("Successfully read file!")
		log!("Time taken (microseconds):", elapsed_us)
		log!("Time taken (milliseconds):", elapsed_ms)

		log!(res.unwrap())
	else:
		log!("Failed to read file.")
