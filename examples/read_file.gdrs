use std::fs::File
use std::time::Instant

fn read_file_test() -> Result<String>:
	let file = File::open("./examples/read_file.gdrs")?
	let contents = file.read_to_string()?
	return Ok(contents)

fn main():
	let start = Instant::now()
	let res = read_file_test()
	let us = start.us()
	let ms = start.ms()

	if res.is_ok():
		log!("sucess")
		log!("(microseconds):", us)
		log!("(milliseconds):", us)

		log!(res.unwrap())
	else:
		log!("Failed to read file.")
