// Main test script for gdrs impl methods

obj Vec2:
	x: i64
	y: i64

impl Vec2:
	fn new(x: i64, y: i64) -> Vec2:
		return Vec2{ x: x, y: y }

	fn area(self) -> i64:
		return self.x * self.y

	fn scale(mut self, factor: i64):
		self.x = self.x * factor
		self.y = self.y * factor

enum Status:
	Active
	Inactive

impl Status:
	fn is_active(self) -> bool:
		if self == Status.Active:
			return true
		else:
			return false

fn main():
	let mut pos = Vec2.new(0, 0)

	while pos.x < 500000:
		pos.x += 1
		log!(pos.x)
	
