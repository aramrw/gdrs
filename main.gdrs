// Positive test: wrapping extern C calls in unsafe block

extern "C":
	fn puts(s: str) -> i64
	fn labs(x: i64) -> i64
	fn system(cmd: str) -> i64

fn main():
	log!("=== Testing GDRS unsafe: Block Encapsulation ===")

	unsafe:
		puts("1. Hello from native C libc puts inside unsafe block!")

		let abs_val = labs(0 - 777)
		log!("2. C libc labs(-777) return value inside unsafe:", abs_val)

		log!("3. Launching macOS Calculator app via C FFI inside unsafe:")
		system("open -a Calculator")
