// Test script for gdrs timing & micro-sleeping

extern "C":
	fn clock() -> i64
	fn usleep(microseconds: i64) -> i64

fn main():
	log!("=== Testing GDRS Native Timing & Sleep ===")

	let start_time = clock()

	log!("Sleeping for 250,000 microseconds (250ms)...")
	usleep(250000)

	let end_time = clock()
	let elapsed = end_time - start_time

	log!("Finished! CPU ticks elapsed:", elapsed)
