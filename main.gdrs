// Main test script for gdrs HashMap standard library collection

mod std_lib::collections::hashmap

fn main():
	log!("=== Testing Native GDRS HashMap ===")

	let mut map = std_lib::collections::hashmap::HashMap.new()
	map = map.insert(1001, 42)
	map = map.insert(2002, 999)
	map = map.insert(3003, 12345)

	log!("map.get(1001) =", map.get(1001))
	log!("map.get(2002) =", map.get(2002))
	log!("map.get(3003) =", map.get(3003))

	log!("map.contains(1001) =", map.contains(1001))
	log!("map.contains(9999) =", map.contains(9999))
