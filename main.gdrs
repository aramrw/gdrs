// Main test script for gdrs Traits, $T Generics, and dyn Trait Dynamic Dispatch

trait Drawable:
	fn draw(self) -> bool

obj Button:
	id: i64

impl Button:
	fn draw(self) -> bool:
		log!("Rendering Button ID:", self.id)
		return true

obj Canvas:
	width: i64

impl Canvas:
	fn draw(self) -> bool:
		log!("Rendering Canvas Width:", self.width)
		return true

fn render_static(item: $T) -> bool where T: Drawable:
	log!("--- Static Monomorphized Render ($T) ---")
	return item.draw()

fn render_dyn(item: dyn Drawable) -> bool:
	log!("--- Dynamic Dispatch Render (dyn Trait) ---")
	return item.draw()

fn main():
	log!("=== Testing GDRS Traits & Generics ===")

	let btn = Button{ id: 101 }
	let cvs = Canvas{ width: 1920 }

	render_static(btn)
	render_static(cvs)

	render_dyn(btn)
